# Every setting here is OPTIONAL — the app runs with no configuration at all.

# ---- Server ----
# Named API_PORT (not PORT) to avoid colliding with the frontend dev server's PORT
# when both are started from the same shell/process (e.g. via `npm run dev` at the root).
# Leave unset when deploying to a host that injects its own PORT (Vercel/Render/etc) —
# the app falls back to that automatically.
API_PORT=8787
# Comma-separated list of allowed frontend origins. Same-origin requests and Vercel's own
# deployment URLs are always allowed, so this is only needed when the frontend is hosted
# on a different domain than the API.
CORS_ORIGIN=http://localhost:5173

# ---- Search (optional) ----
# Without these the app uses keyless sources (DuckDuckGo + Wikipedia), which work with zero
# setup but have thinner coverage. Google Programmable Search gives noticeably better results
# and is free for 100 queries/day:
#   1. Create a search engine at https://programmablesearchengine.google.com/ ("Search the
#      entire web"), and copy its Search engine ID into GOOGLE_SEARCH_ENGINE_ID.
#   2. Create an API key with the "Custom Search API" enabled at
#      https://console.cloud.google.com/apis/credentials and put it in GOOGLE_SEARCH_API_KEY.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---- History storage ----
# "file" persists to backend/data/history.json (default, zero-config).
# "postgres" requires DATABASE_URL and is left as an extension point — see README.
HISTORY_STORE=file
DATABASE_URL=

# ---- Accuracy ----
# Minimum OCR confidence (0-1) required before attempting an answer. OCR runs in the
# browser (Tesseract.js) and reports its own confidence per capture.
MIN_OCR_CONFIDENCE=0.55
