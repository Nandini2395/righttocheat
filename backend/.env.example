# ---- Server ----
# Named API_PORT (not PORT) to avoid colliding with the frontend dev server's PORT
# when both are started from the same shell/process (e.g. via `npm run dev` at the root).
# Leave unset when deploying to a host that injects its own PORT (Render/Railway/etc) —
# the app falls back to that automatically.
API_PORT=8787
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://your-username.github.io
CORS_ORIGIN=http://localhost:5173

# ---- LLM provider (used for vision OCR/extraction, answer generation, and verification reasoning) ----
# One of: google | anthropic | openai
# "google" (Gemini) is the default because it has a free tier with no credit card required —
# get a key in ~2 minutes at https://aistudio.google.com/apikey
LLM_PROVIDER=google

# Google Gemini (used when LLM_PROVIDER=google) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_TEXT_MODEL=gemini-flash-lite-latest

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

# ---- Web search verification (Google Programmable Search / Custom Search JSON API) ----
# Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# and an API key at https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---- History storage ----
# "file" persists to backend/data/history.json (default, zero-config).
# "postgres" requires DATABASE_URL and is left as an extension point — see README.
HISTORY_STORE=file
DATABASE_URL=

# ---- Accuracy thresholds ----
# Minimum OCR/vision confidence (0-1) required before attempting an answer.
MIN_OCR_CONFIDENCE=0.55
